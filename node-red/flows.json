    "id": "mqtt-build",
    "type": "function",
    "z": "memo-mqtt",
    "name": "建立 MQTT 感測封包",
    "x": 460,
    "y": 440,
    "wires": [
      [
        "mqtt-publish"
      ]
    ],
    "func": "const device = env.get('DEVICE_ID') || 'room01';\nconst sequence = (flow.get('memo_mqtt_sequence') || 0) + 1;\nflow.set('memo_mqtt_sequence', sequence);\n// Random walk inside a normal band below the backend alert thresholds: [min, max, max step, centre].\nconst NORMAL = {temperature_c: [23, 27.5, 0.12, 25], humidity_pct: [45, 68, 0.8, 58], co2_ppm: [550, 950, 20, 750]};\nconst LIMIT = {temperature_c: [-20, 50], humidity_pct: [0, 100], co2_ppm: [350, 5000]};\nconst clamp = (value, [low, high]) => Math.min(high, Math.max(low, value));\nconst base = flow.get('memo_mqtt_base') || {};\nconst target = flow.get('memo_mqtt_anomaly') || {};\nconst applied = flow.get('memo_mqtt_applied') || {};\nconst metrics = {};\nfor (const [key, [low, high, step, centre]] of Object.entries(NORMAL)) {\n  const previous = base[key] ?? centre;\n  base[key] = clamp(previous + (Math.random() * 2 - 1) * step + (centre - previous) * 0.02, [low, high]);\n  // Manual anomaly offsets ease in and out over a few samples instead of jumping.\n  const goal = target[key] || 0, current = applied[key] || 0;\n  applied[key] = Math.abs(goal - current) < step ? goal : current + (goal - current) * 0.35;\n  metrics[key] = Number(clamp(base[key] + applied[key], LIMIT[key]).toFixed(key === 'co2_ppm' ? 0 : 1));\n}\nflow.set('memo_mqtt_base', base);\nflow.set('memo_mqtt_applied', applied);\nconst abnormal = Object.values(applied).some(Boolean);\nnode.status({fill: abnormal ? 'red' : 'green', shape: 'dot', text: metrics.temperature_c + '°C ' + metrics.humidity_pct + '% ' + metrics.co2_ppm + 'ppm'});\nmsg.topic = 'memo/v1/' + device + '/telemetry';\nmsg.payload = {schema_version:1, message_id:device + '-' + Date.now() + '-' + msg._msgid,\n  device_id:device, observed_at:new Date().toISOString(), sequence:sequence, metrics, quality:'ok'};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": []
  },
