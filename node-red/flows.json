    "func": "const base = (env.get('MEMO_API_URL') || 'http://api:8000').replace(/\\/$/, '');\nconst device = env.get('MEMO_DEVICE_ID') || 'room01';\nmsg.method = 'POST';\nmsg.url = base + '/api/v1/telemetry';\nmsg.headers = {'Content-Type':'application/json'};\nmsg.payload = {schema_version:1, message_id:device + '-' + Date.now() + '-' + msg._msgid, device_id:device, observed_at:new Date().toISOString(), sequence:1, metrics:{temperature_c:29.2, humidity_pct:65, co2_ppm:1100}, quality:'ok'};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": []
  },
