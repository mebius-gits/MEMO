        "vt": "str"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 2,
    "topic": "",
    "payload": "",
    "payloadType": "date"
  },
  {
    "id": "register-build",
    "type": "function",
    "z": "memo-flow",
    "name": "準備裝置註冊",
    "x": 390,
    "y": 140,
    "wires": [
      [
        "register-http"
      ]
    ],
    "func": "const base = (env.get('MEMO_API_URL') || 'http://api:8000').replace(/\\/$/, '');\nconst device = env.get('MEMO_DEVICE_ID') || 'room01';\nmsg.method = 'POST';\nmsg.url = base + '/api/v1/devices';\nmsg.headers = {'Content-Type':'application/json'};\nmsg.payload = {id: device, name: 'MEMO 模擬裝置', location:'示範空間'};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": []
  },
  {
    "id": "register-http",
    "type": "http request",
    "z": "memo-flow",
    "name": "POST /devices",
    "x": 620,
    "y": 140,
    "wires": [
      [
        "register-status"
      ]
    ],
    "method": "use",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": []
