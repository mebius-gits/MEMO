    "func": "const base = (env.get('MEMO_API_URL') || 'http://api:8000').replace(/\\/$/, '');\nconst device = env.get('MEMO_DEVICE_ID') || 'room01';\nmsg.method = 'GET';\nmsg.url = base + '/api/v1/devices/' + encodeURIComponent(device) + '/readings?limit=10';\nmsg.headers = {};\ndelete msg.payload;\nreturn msg;",
