  {
    "id": "mqtt-anomaly",
    "type": "function",
    "z": "memo-mqtt",
    "name": "設定異常值",
    "x": 470,
    "y": 790,
    "wires": [
      [
        "mqtt-anomaly-debug"
      ]
    ],
    "func": "// payload {metric, delta} adds to that metric's anomaly offset; {reset: true} clears all offsets.\nconst input = msg.payload;\nif (!input || typeof input !== 'object') return null;\nconst target = input.reset ? {} : {...(flow.get('memo_mqtt_anomaly') || {})};\nif (!input.reset) {\n  if (!['temperature_c', 'humidity_pct', 'co2_ppm'].includes(input.metric) || !Number.isFinite(input.delta)) {\n    node.warn('payload 需為 {\"metric\": \"co2_ppm\", \"delta\": 700} 或 {\"reset\": true}');\n    return null;\n  }\n  target[input.metric] = (target[input.metric] || 0) + input.delta;\n}\nflow.set('memo_mqtt_anomaly', target);\nconst labels = {temperature_c: '溫度', humidity_pct: '濕度', co2_ppm: 'CO₂'};\nconst text = Object.entries(target).filter(([, value]) => value).map(([key, value]) => labels[key] + (value > 0 ? ' +' : ' ') + value).join('、') || '正常';\nnode.status({fill: text === '正常' ? 'green' : 'red', shape: 'dot', text});\nmsg.payload = {anomaly_offset: target, sending: flow.get('memo_mqtt_enabled') === true};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": []
  },
