    "libs": [],
    "func": "const base = (env.get('MEMO_API_URL') || 'http://api:8000').replace(/\\/$/, '');\nmsg.method = 'POST';\nmsg.url = base + '/api/v1/llm/respond';\nmsg.headers = {'Content-Type':'application/json'};\nmsg.payload = {\n  user_message:'MEMO，請摘要這筆模擬環境資料。',\n  personality:{name:'MEMO', language:'zh-TW', tone:'gentle'},\n  context:{device_id:env.get('MEMO_DEVICE_ID') || 'room01', observation:{\n    observed_at:new Date().toISOString(),\n    metrics:{temperature_c:29.2, humidity_pct:65, co2_ppm:1100}, quality:'ok'\n  }}\n};\nreturn msg;"
