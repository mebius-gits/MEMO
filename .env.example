APP_NAME=MEMO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://memo-quiet-room.fancyhen36.chatgpt.site"]
DATABASE_URL=sqlite:///./memo.db
# PostgreSQL: postgresql+psycopg://memo:password@localhost:5432/memo

# Chat Completions-compatible model connection. Missing URL/model uses template fallback.
# Set an API base URL including its version path, e.g. http://localhost:11434/v1
# In Docker, use a hostname reachable from the API container, not localhost.
# Leave LLM_BASE_URL unset until a model endpoint is available.
# LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
NOTIFICATIONS_ENABLED=true

# Independent MQTT worker (Compose overrides host to broker).
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=memo-environment-worker
MQTT_QUEUE_SIZE=256
