MEMO_APP_NAME=MEMO
MEMO_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://memo-quiet-room.fancyhen36.chatgpt.site"]
MEMO_DATABASE_URL=sqlite:///./memo.db
# PostgreSQL: postgresql+psycopg://memo:password@localhost:5432/memo

# Model connection settings (reserved; current reply generator uses templates).
# Set an API base URL including its version path, e.g. http://localhost:11434/v1
# In Docker, use a hostname reachable from the API container, not localhost.
# Leave MEMO_LLM_BASE_URL unset until a model endpoint is available.
# MEMO_LLM_BASE_URL=http://localhost:11434/v1
MEMO_LLM_MODEL=
MEMO_LLM_API_KEY=
MEMO_LLM_TIMEOUT_SECONDS=30

# Independent MQTT worker (Compose overrides host to broker).
MEMO_MQTT_HOST=localhost
MEMO_MQTT_PORT=1883
MEMO_MQTT_CLIENT_ID=memo-environment-worker
MEMO_MQTT_QUEUE_SIZE=256
