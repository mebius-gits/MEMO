APP_NAME=MEMO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://memo-quiet-room.fancyhen36.chatgpt.site"]
DATABASE_URL=sqlite:///./memo.db
# PostgreSQL: postgresql+psycopg://memo:password@localhost:5432/memo

# OpenAI-style Chat Completions connection. Without OPENAI_MODEL replies use templates.
# OPENAI_BASE_URL includes the version path and defaults to https://api.openai.com/v1;
# set it for compatible servers, e.g. Ollama http://localhost:11434/v1 (key may stay empty).
# In Docker, use a hostname reachable from the API container, not localhost.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30
# Optional; sent only when set. Reasoning models answer short replies far faster with
# low or none (e.g. gpt-oss: low; Gemma 4: none turns thinking off).
# OPENAI_REASONING_EFFORT=low
# OPENAI_MAX_COMPLETION_TOKENS=400
# Compatibility: set false when the model ignores the system role (instructions then go
# in the user message) or returns "{}" in JSON mode. Gemma 4 behind BIRC needs both false.
# OPENAI_SYSTEM_ROLE=true
# OPENAI_JSON_MODE=true
NOTIFICATIONS_ENABLED=true

# Independent MQTT worker (Compose overrides host to broker).
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=memo-environment-worker
MQTT_QUEUE_SIZE=256
