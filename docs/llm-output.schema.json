      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "emotion": {
      "$ref": "#/$defs/EmotionOutput"
    }
  },
  "required": [
    "text",
    "emotion"
  ],
  "title": "ModelReply",
  "type": "object"
