{
  "$defs": {
    "EmotionLabel": {
      "enum": [
        "neutral",
        "friendly",
        "concerned",
        "happy",
        "confused",
        "surprised",
        "proud",
        "sleepy",
        "alert"
      ],
      "title": "EmotionLabel",
      "type": "string"
    },
    "EmotionOutput": {
