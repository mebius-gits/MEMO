# Public build-time API origin. Do not put model API keys in VITE_* variables.
# Copy to .env.local for local development. Restart Vite after changes.
# For a hosted HTTPS site, replace with your reachable HTTPS backend and rebuild.
VITE_API_URL=http://localhost:8000
# Node-RED origin for the 環境干擾 panel (Compose publishes it on 1880).
VITE_NODE_RED_URL=http://localhost:1880
